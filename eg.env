# Elastic Cloud Configuration (Required for /mcp and /data)
ELASTIC_URL=https://your-project-id.es.region.gcp.elastic-cloud.com:443
ELASTIC_API_KEY=your_base64_encoded_api_key_here

# Gemma 4 LLM Configuration (Required for /agent)
GEMMA_API_KEY=your_llm_provider_key_here

# Flask Backend Config
FLASK_PORT=5000
FLASK_ENV=development
