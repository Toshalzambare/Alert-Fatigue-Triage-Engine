apiVersion: v1
kind: Secret
metadata:
  name: triage-secrets
type: Opaque
stringData:
  # Replace these with your actual base64 encoded secrets or plain text strings (stringData takes plaintext)
  ELASTIC_URL: "https://your-elastic-url:443"
  ELASTIC_API_KEY: "your-elastic-key"
  GEMMA_API_KEY: "your-gemma-key"
