# Copy to .env and fill in. Nothing here is required for Phases 0-1 (mock mode).

# --- Elastic Cloud (Teammate B) ---
ES_CLOUD_ID=
ES_API_KEY=
ES_INDEX=secops-logs-*

# --- FastMCP (Teammate C) ---
MCP_MODE=http
MCP_URL=http://localhost:8000/mcp

# --- Gemma (Teammate D) --- runtime still undecided
GEMMA_MODEL=gemma-4-12b-it

# --- Server ---
PORT=5001
HOST=127.0.0.1
DEBUG=true

# --- Demo ---
DEMO_REPLAY=false
MOCK_DELAY_MS=300
STREAM_TIMEOUT_S=120
